#!/bin/bash
set -euo pipefail
install_bloom() {
  local base=https://artifacts.videodb.io/bloom/internal/linux
  local version name expected installed
  [[ $(uname -s) == Linux && $(dpkg --print-architecture) == amd64 ]] || { echo 'Ubuntu amd64 is required.' >&2; return 1; }
  download() { curl --proto '=https' --proto-redir '=https' -fsSL "$@"; }
  version=$(download "$base/latest-version.txt")
  [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+-linux\.preview\.[0-9]+$ ]] || { echo 'Invalid release version.' >&2; return 1; }
  if [[ $# -gt 0 ]]; then [[ $# == 1 && $1 == "$version" ]] || { echo 'Release changed. Check again.' >&2; return 1; }; fi
  name="bloom-$version-amd64.deb"
  tmp=$(mktemp -d)
  trap 'rm -rf -- "$tmp"' EXIT
  cd "$tmp"
  download "$base/v$version/$name" -o "$name"
  download "$base/v$version/$name.sha256" -o checksum
  download "$base/v$version/$name.sha256.sig" -o signature
  cat > key.pem <<'KEY'
-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEAV2SHRryruQ0tpNlloZJvODor6heJHjJGr2qzqp6J0Tc=
-----END PUBLIC KEY-----
KEY
  openssl pkeyutl -verify -pubin -inkey key.pem -rawin -in checksum -sigfile signature >/dev/null
  expected=$(sha256sum "$name")
  [[ $(cat checksum) == "$expected" ]] || { echo 'Package checksum mismatch.' >&2; return 1; }
  [[ $(dpkg-deb -f "$name" Package) == bloom && $(dpkg-deb -f "$name" Architecture) == amd64 && $(dpkg-deb -f "$name" Version) == "${version/-/\~}" ]] || { echo 'Package identity mismatch.' >&2; return 1; }
  installed=$(dpkg-query -W -f='${Version}' bloom 2>/dev/null || true)
  if [[ -n $installed ]] && dpkg --compare-versions "$installed" gt "${version/-/\~}"; then echo 'A newer Bloom is installed.'; return; fi
  if [[ $EUID == 0 ]]; then apt-get install -y "./$name"; else sudo apt-get install -y "./$name"; fi
}
(install_bloom "$@")
